{
  "name": "minigolf-parabolico",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently -k -n server,client \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "db:init": "node server/migrate.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
